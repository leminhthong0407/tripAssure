# TripAssure — Database credentials
# Copy this file to .env and fill in values.
# NEVER commit .env to version control (add .env to .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=TravelInsuranceDB

# Role options: tripAssure_admin | tripAssure_agent | tripAssure_assessor
DB_USER=tripAssure_admin
DB_PASSWORD=your_password_here
